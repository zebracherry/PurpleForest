# Keep line endings stable no matter what core.autocrlf says on the
# machine that cloned the repo. Bash and YAML break on CRLF; PowerShell
# is happiest with it.
* text=auto
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.j2        text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
Vagrantfile text eol=lf
*.ps1       text eol=crlf
