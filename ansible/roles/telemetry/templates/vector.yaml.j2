# Managed by Ansible -- edit roles/telemetry/templates/vector.yaml.j2
#
# VERIFY AGAINST YOUR VECTOR VERSION. The Windows event log source has been
# renamed across releases. Check what your build supports with:
#   vector list
# and adjust the `type:` fields below if they do not match.

data_dir: "C:\\ProgramData\\vector"

sources:
  windows_security:
    type: windows_event_log
    channels:
      - Security

  windows_system:
    type: windows_event_log
    channels:
      - System

  sysmon:
    type: windows_event_log
    channels:
      - "Microsoft-Windows-Sysmon/Operational"

  powershell:
    type: windows_event_log
    channels:
      - "Microsoft-Windows-PowerShell/Operational"
      - "Windows PowerShell"

transforms:
  enrich:
    type: remap
    inputs:
      - windows_security
      - windows_system
      - sysmon
      - powershell
    source: |
      .lab_host    = "{{ inventory_hostname }}"
      .lab_role    = "{{ 'domain_controller' if inventory_hostname in groups['domain_controllers'] else 'workstation' }}"
      .lab_domain  = "{{ domain_name }}"
      .ingested_at = now()

      # Windows puts everything a detection actually needs -- the service
      # name, the encryption type, the target account -- inside the event's
      # EventData section, which arrives here as one nested object. Graylog's
      # GELF input has no nested fields, so it collapses the whole thing into
      # a single JSON string and a query for an encryption type has to
      # substring-match that blob: slow, and wrong, because it matches the
      # value in any field. Flatten it to real top-level fields instead.
      #
      # The keys keep Microsoft's own names -- TargetUserName,
      # TicketEncryptionType, ServiceName -- which is what Sigma rules are
      # written against, so a rule maps to a Graylog field one to one.
      # Existing fields win on a collision, so this can never clobber
      # event_id, channel or the GELF keys below.
      #
      # The source hands EventData over as a map; older builds give a JSON
      # string instead, so accept either.
      event_fields = {}
      if is_object(.event_data) {
        event_fields = object!(.event_data)
      } else if is_string(.event_data) {
        decoded, err = parse_json(string!(.event_data))
        if err == null && is_object(decoded) {
          event_fields = object!(decoded)
        }
      }
      if length(event_fields) > 0 {
        . = merge(event_fields, .)
        del(.event_data)          # flattened above; keeping it doubles the index
      }

      # Graylog's GELF input wants these field names.
      .host         = "{{ inventory_hostname }}"
      .short_message = to_string(.message) ?? "windows event"
      .version      = "1.1"

sinks:
  graylog:
    type: socket
    inputs:
      - enrich
    address: "{{ siem_ip }}:{{ graylog_gelf_port }}"
    mode: tcp
    encoding:
      codec: json
    framing:
      method: character_delimited
      character_delimited:
        delimiter: "\0"        # GELF TCP requires null-delimited frames
    buffer:
      type: disk
      max_size: 536870912      # 512 MB -- survives SIEM downtime
      when_full: block
