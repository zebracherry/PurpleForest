---
# Alignment in group_vars is deliberate and improves readability,
# so the colons rule is relaxed rather than the files reformatted.
extends: default

rules:
  colons:
    max-spaces-after: -1
  line-length:
    max: 160
    level: warning
  truthy:
    allowed-values: ['true', 'false']
  comments:
    min-spaces-from-content: 1
  # ansible-lint requires these four settings of any custom yamllint config;
  # without them it disables its own fix mode and warns on every run.
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true

ignore: |
  .github/
